# QNX SDP 8.0 CMake Toolchain
cmake_minimum_required(VERSION 3.25)
set(CMAKE_SYSTEM_NAME QNX)

if(NOT DEFINED CMAKE_SYSTEM_PROCESSOR)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
endif()

set(CMAKE_C_COMPILER   $ENV{QNX_HOST}/usr/bin/qcc)
set(CMAKE_CXX_COMPILER $ENV{QNX_HOST}/usr/bin/q++)

if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64le")
  set(CMAKE_C_COMPILER_TARGET gcc_ntoaarch64le)
  set(CMAKE_SYSROOT $ENV{QNX_TARGET}/aarch64le)
else()
  set(CMAKE_C_COMPILER_TARGET gcc_ntox86_64)
  set(CMAKE_SYSROOT $ENV{QNX_TARGET}/x86_64)
endif()
