# QNX SDP 8.0 CMake Toolchain File
# Generated by QNX Sentinel
# Official QNX 8.0 compliant cross-compilation toolchain for CMake 3.25+

cmake_minimum_required(VERSION 3.25)

set(CMAKE_SYSTEM_NAME QNX)

# Default to aarch64 if not specified by user
if(NOT DEFINED CMAKE_SYSTEM_PROCESSOR)
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
endif()

# Environment validation
if(NOT DEFINED ENV{QNX_HOST} OR NOT DEFINED ENV{QNX_TARGET})
  message(FATAL_ERROR "QNX_HOST and QNX_TARGET environment variables must be defined. "
                      "Please run: source ~/qnx800/qnxsdp-env.sh (or C:\\qnx800\\qnxsdp-env.bat)")
endif()

set(QNX_HOST   "$ENV{QNX_HOST}")
set(QNX_TARGET "$ENV{QNX_TARGET}")

# Compiler drivers
set(CMAKE_C_COMPILER   "${QNX_HOST}/usr/bin/qcc")
set(CMAKE_CXX_COMPILER "${QNX_HOST}/usr/bin/q++")

# Configure target architecture variant for qcc -V
if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64le")
  set(QNX_ARCH "aarch64le")
  set(QNX_TARGET_VARIANT "gcc_ntoaarch64le")
elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
  set(QNX_ARCH "x86_64")
  set(QNX_TARGET_VARIANT "gcc_ntox86_64")
else()
  message(FATAL_ERROR "Unsupported QNX architecture: ${CMAKE_SYSTEM_PROCESSOR}. Supported: aarch64, x86_64")
endif()

# Target and sysroot configuration
set(CMAKE_C_COMPILER_TARGET   "${QNX_TARGET_VARIANT}")
set(CMAKE_CXX_COMPILER_TARGET "${QNX_TARGET_VARIANT}")
set(CMAKE_SYSROOT             "${QNX_TARGET}/${QNX_ARCH}")

# Search mode policies
set(CMAKE_FIND_ROOT_PATH "${QNX_TARGET}/${QNX_ARCH}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# QNX 8.0 Standard C++ library defaults to LLVM libc++
set(CMAKE_CXX_FLAGS_INIT "-stdlib=libc++")
