{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "qnx-aarch64-debug",
      "displayName": "QNX SDP 8.0 AArch64 (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qnx-aarch64-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "QNX",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/qnx.toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
